<div class="dropdown hamburger">
  <div tabindex="0" role="button" class="btn btn-ghost btn-circle">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /> </svg>
  </div>
  <ul
    tabindex="0"
    class="menu menu-sm dropdown-content bg-base-300 rounded-box z-1 mt-3 w-52 p-2 shadow">
    <li><a href="/" class="text-sm">
      <House class="w-5 h-5"/>
      Home
    </a></li>
    <li><a href="/work/" class="text-sm">
      <BriefcaseBusiness class="w-5 h-5"/>
      Work
    </a></li>
    <li><a href="/projects/" class="text-sm">
      <FileCode2 class="w-5 h-5"/>
      Projects
    </a></li>
    <li><a href="/tags/" class="text-sm">
      <NotepadText class="w-5 h-5"/>
      Posts
